{
  "name": "blunderlab",
  "private": true,
  "version": "0.1.0",
  "description": "Personal chess-improvement app: Chess.com sync, on-device Stockfish review, puzzles from your own mistakes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "build:openings": "node scripts/build-openings.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
    "android:assets": "node scripts/make-icon-sources.mjs && capacitor-assets generate --android --assetPath resources --iconBackgroundColor #191d24 --iconBackgroundColorDark #191d24 --splashBackgroundColor #07080b --splashBackgroundColorDark #07080b"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "hyparquet": "^1.33.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
